# =============================================================================
# Craft Agents Server — multi-platform Docker image
#
# Build:
#   docker buildx build -f Dockerfile.server -t datapilot-server .
#
# Run (use --user to match host UID/GID for volume permissions):
#   docker run --rm -p 9100:9100 \
#     --user $(id -u):$(id -g) \
#     -e HOME=/home/datapilot \
#     -e DATAPILOT_SERVER_TOKEN=<secret> \
#     datapilot-server
#
# Run with TLS + mounted config:
#   docker run --rm -p 9100:9100 \
#     --user $(id -u):$(id -g) \
#     -e HOME=/home/datapilot \
#     -e DATAPILOT_SERVER_TOKEN=<secret> \
#     -e DATAPILOT_RPC_TLS_CERT=/certs/cert.pem \
#     -e DATAPILOT_RPC_TLS_KEY=/certs/key.pem \
#     -v /path/to/certs:/certs:ro \
#     -v ~/.datapilot:/home/datapilot/.datapilot \
#     datapilot-server
# =============================================================================

FROM nikolaik/python-nodejs:python3.12-nodejs20-slim

# Reset SHELL to default — nikolaik image sets bash -euo pipefail which breaks some commands
SHELL ["/bin/sh", "-c"]

LABEL org.opencontainers.image.source="https://github.com/i-richardwang/datapilot"
LABEL org.opencontainers.image.description="DataPilot Server — headless AI workflow server"
LABEL org.opencontainers.image.licenses="Apache-2.0"

# Install uv (Python package manager) — doc tools use uv to run Python scripts.
COPY --from=ghcr.io/astral-sh/uv:0.10.6 /uv /usr/local/bin/uv

# Copy bun binary from official image
COPY --from=oven/bun:1.3-slim /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx

# Install system deps
# fd-find: Debian package installs the binary as `fdfind`; symlink to `fd` so
# the agent's Find tool can locate it on PATH (otherwise it tries to download
# from GitHub at runtime and fails in restricted networks).
# libpango / libpangoft2: WeasyPrint runtime — pango pulls in
# glib/gobject/cairo transitively. fonts-noto-cjk + fonts-noto-core: cover the
# report-weaver Charter→Georgia→serif chain on a slim base image (Charter is
# macOS-only) and give CJK fallback for `lang="zh-CN"` slides — without these
# Latin renders sans and CJK becomes tofu in the PDF.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates git gosu ripgrep fd-find jq curl gnupg \
      libpango-1.0-0 libpangoft2-1.0-0 \
      fonts-noto-core fonts-noto-cjk \
      libreoffice-impress libreoffice-writer libreoffice-calc libreoffice-core \
      poppler-utils && \
    ln -s /usr/bin/fdfind /usr/local/bin/fd && \
    rm -rf /var/lib/apt/lists/*

# soffice wrapper: HOME is bind-mounted from macOS at runtime and unwritable,
# so /usr/bin/soffice fails with "User installation could not be completed".
# Inject a per-invocation UserInstallation under /tmp (and a writable
# fontconfig cache) so `soffice --headless --convert-to pdf foo.pptx` works
# out of the box for agent-driven PPT→PDF→PNG verification.
RUN printf '%s\n' \
    '#!/bin/sh' \
    'PROFILE_DIR=$(mktemp -d /tmp/lo-profile.XXXXXX)' \
    'export FONTCONFIG_PATH="${FONTCONFIG_PATH:-/etc/fonts}"' \
    'export XDG_CACHE_HOME="$PROFILE_DIR/cache"' \
    'mkdir -p "$XDG_CACHE_HOME"' \
    '/usr/bin/soffice -env:UserInstallation="file://$PROFILE_DIR" "$@"' \
    'rc=$?' \
    'rm -rf "$PROFILE_DIR"' \
    'exit $rc' \
    > /usr/local/bin/soffice && \
    chmod +x /usr/local/bin/soffice

# RTK (https://github.com/rtk-ai/rtk) — Rust-built Bash output compressor that
# the agent's PreToolUse pipeline transparently routes Bash commands through
# to compress git/test/grep/ls etc. output by 60-90% before it reaches the LLM.
# Detected at runtime via `which rtk`; user enables in Settings → AI → Performance.
# Uses RTK's official install.sh so OS/arch detection and URL building stay in
# sync with upstream automatically. Version pinned for reproducible builds —
# bump RTK_VERSION as new releases land.
ARG RTK_VERSION=v0.40.0
RUN curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh \
    | RTK_VERSION="$RTK_VERSION" RTK_INSTALL_DIR=/usr/local/bin sh && \
    rtk --version

# Create non-root user (Claude Code SDK refuses to run as root).
# At runtime, override with --user $(id -u):$(id -g) to match host permissions.
RUN groupadd -r datapilot && \
    useradd -r -g datapilot -m -d /home/datapilot -s /bin/bash datapilot

WORKDIR /app

# Optional package-registry mirrors for environments where the public
# registries (npmjs.org / pypi.org) are slow or block TLS. Empty default
# preserves upstream behavior so this Dockerfile merges cleanly.
ARG NPM_REGISTRY=""
ARG PIP_INDEX_URL=""

# Copy dependency manifests first for layer caching.
# bunfig.toml must be present *before* `bun install` runs so the hoisted
# linker setting is honored; otherwise bun falls back to configVersion=1's
# isolated default and Vite can't resolve transitive deps during webui build.
COPY package.json bun.lock bunfig.toml ./
COPY packages/server/package.json packages/server/
COPY packages/server-core/package.json packages/server-core/
COPY packages/shared/package.json packages/shared/
COPY packages/core/package.json packages/core/
COPY packages/session-tools-core/package.json packages/session-tools-core/
COPY packages/session-mcp-server/package.json packages/session-mcp-server/
COPY packages/pi-agent-server/package.json packages/pi-agent-server/
COPY packages/ui/package.json packages/ui/
COPY packages/messaging-gateway/package.json packages/messaging-gateway/
COPY packages/messaging-whatsapp-worker/package.json packages/messaging-whatsapp-worker/
COPY apps/electron/package.json apps/electron/
COPY apps/cli/package.json apps/cli/
COPY apps/viewer/package.json apps/viewer/
COPY apps/viewer-server/package.json apps/viewer-server/
COPY apps/webui/package.json apps/webui/

# Skip better-sqlite3 native build — Docker runs on Bun which uses built-in bun:sqlite
# When NPM_REGISTRY is set, write it to .npmrc so bun install routes through the mirror.
RUN if [ -n "$NPM_REGISTRY" ]; then echo "registry=$NPM_REGISTRY" > /root/.npmrc; fi
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --ignore-scripts || \
    (rm -rf /root/.bun/install/cache/* && bun install --frozen-lockfile --ignore-scripts)

# Copy source
COPY . .

# Build MCP helper servers (bundled CJS — required by runtime-resolver.ts)
RUN bun build packages/session-mcp-server/src/index.ts \
      --outfile packages/session-mcp-server/dist/index.js --target node --format cjs && \
    bun build packages/pi-agent-server/src/index.ts \
      --outfile packages/pi-agent-server/dist/index.js --target node --format cjs

# Build the WhatsApp worker bundle (CJS, Node target — Bun cannot run it).
RUN bun run scripts/build-wa-worker.ts

# Build web UI assets (served by the server on the RPC port)
# Granular feature flags — set to "1" to disable/enable the corresponding feature.
ARG DATAPILOT_DISABLE_OAUTH="1"
ARG DATAPILOT_DISABLE_BROWSER="1"
ARG DATAPILOT_DISABLE_VALIDATION=""
ARG DATAPILOT_DISABLE_TEMPLATES=""
ARG DATAPILOT_DISABLE_SANDBOX="1"
ARG DATAPILOT_DISABLE_MESSAGING="1"
ARG DATAPILOT_LITE_UI="1"
ENV DATAPILOT_DISABLE_OAUTH=$DATAPILOT_DISABLE_OAUTH
ENV DATAPILOT_DISABLE_BROWSER=$DATAPILOT_DISABLE_BROWSER
ENV DATAPILOT_DISABLE_VALIDATION=$DATAPILOT_DISABLE_VALIDATION
ENV DATAPILOT_DISABLE_TEMPLATES=$DATAPILOT_DISABLE_TEMPLATES
ENV DATAPILOT_DISABLE_SANDBOX=$DATAPILOT_DISABLE_SANDBOX
ENV DATAPILOT_DISABLE_MESSAGING=$DATAPILOT_DISABLE_MESSAGING
ENV DATAPILOT_LITE_UI=$DATAPILOT_LITE_UI
# vite's bundler runs under Node (via shebang in vite's bin) and hits V8's
# default ~2GB heap cap on the rendering phase (>5k modules). Raise to 4GB
# so low-RAM build hosts (e.g. 4GB VPS) can complete the build.
RUN NODE_OPTIONS="--max-old-space-size=4096" bunx vite build --config apps/webui/vite.config.ts

# Pre-create .datapilot so Docker named volumes inherit the correct permissions.
RUN mkdir -p /home/datapilot/.datapilot

# Make app world-readable so any --user can run it. Home dir is writable for .datapilot.
# Use find to only touch files/dirs missing the read bit — much faster than chmod -R on the
# entire tree (node_modules alone has hundreds of thousands of entries).
RUN find /app -not -perm -o=r -exec chmod o+r {} + && \
    find /app -type d -not -perm -o=x -exec chmod o+x {} + && \
    chmod -R 777 /home/datapilot

# Pre-install common data-science packages into a dedicated venv.
# Base image already ships Python 3.12 + pip; we create a venv via uv for isolation.
# - DATAPILOT_PYTHON: used by transform_data runtime resolver for direct Python access
# - PATH addition: makes python3/pip available in Bash for exploratory analysis
RUN uv venv /opt/datapilot-py --python python3 && \
    uv pip install --python /opt/datapilot-py/bin/python \
      ${PIP_INDEX_URL:+--index-url "$PIP_INDEX_URL"} \
      pandas numpy pyarrow polars openpyxl xlsxwriter \
      weasyprint pypdf pymupdf python-pptx python-docx markitdown && \
    chmod -R a+rX /opt/datapilot-py

ENV DATAPILOT_RPC_HOST=0.0.0.0
ENV DATAPILOT_RPC_PORT=9100
ENV DATAPILOT_WEBUI_DIR=/app/apps/webui/dist
# Resource resolution — aligned with build-server.ts production entry script
ENV DATAPILOT_BUNDLED_ASSETS_ROOT=/app/apps/electron
ENV DATAPILOT_IS_PACKAGED=false
ENV DATAPILOT_APP_ROOT=/app
ENV DATAPILOT_RESOURCES_PATH=/app/apps/electron/resources
ENV DATAPILOT_PYTHON=/opt/datapilot-py/bin/python
ENV DATAPILOT_UV=/usr/local/bin/uv
ENV DATAPILOT_SCRIPTS=/app/apps/electron/resources/scripts
# WhatsApp worker — Bun cannot run the CJS worker, so we point the adapter at
# system `node` (installed above). If DATAPILOT_BUNDLED_ASSETS_ROOT changes,
# update DATAPILOT_MESSAGING_WA_WORKER to match; the default in packages/server
# resolves against DATAPILOT_BUNDLED_ASSETS_ROOT, but the layout above flattens
# to /app.
ENV DATAPILOT_MESSAGING_WA_WORKER=/app/packages/messaging-whatsapp-worker/dist/worker.cjs
ENV DATAPILOT_MESSAGING_NODE_BIN=node
ENV PATH="/opt/datapilot-py/bin:/app/apps/electron/resources/bin:${PATH}"

EXPOSE 9100

# Smart entrypoint: drop from root to datapilot when the container platform
# (e.g. Zeabur) ignores the Dockerfile USER directive and runs as root.
# Claude Agent SDK refuses --dangerously-skip-permissions under root.
RUN printf '#!/bin/sh\nset -e\nif [ "$(id -u)" = "0" ]; then\n  export HOME="${HOME:-/home/datapilot}"\n  mkdir -p "$HOME"\n  chown -R datapilot:datapilot "$HOME" 2>/dev/null || true\n  exec gosu datapilot "$@"\nfi\nexec "$@"\n' > /usr/local/bin/entrypoint.sh && \
    chmod +x /usr/local/bin/entrypoint.sh

# Default to non-root, but entrypoint handles root->datapilot fallback
USER datapilot

# --allow-insecure-bind: safe inside Docker — the container network is isolated;
# external TLS should be handled by a reverse proxy (nginx, Caddy, etc.)
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bun", "run", "packages/server/src/index.ts", "--allow-insecure-bind"]
