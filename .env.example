# Required: Anthropic API Key for Claude
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth Configuration (OPTIONAL - for development/testing only)
# For production use, users should provide their own credentials via source configuration.
# These env vars serve as a fallback if source config doesn't specify credentials.
# See README_FOR_OSS.md for setup instructions.
# To create credentials: Google Cloud Console > APIs & Services > Credentials > Desktop app
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Slack OAuth Configuration (for Slack workspace integration)
# Get these from Slack API > Your Apps > OAuth & Permissions
SLACK_OAUTH_CLIENT_ID=your-slack-client-id
SLACK_OAUTH_CLIENT_SECRET=your-slack-client-secret

# Microsoft OAuth Configuration (for Outlook, OneDrive, Teams integration)
# Get these from Azure Portal > App Registrations
# Note: Create a "Mobile and desktop applications" platform OAuth client - PKCE is used so no client_secret is needed
MICROSOFT_OAUTH_CLIENT_ID=your-microsoft-client-id

# Granular Feature Flags (set to 1 to enable)
# DATAPILOT_DISABLE_OAUTH=1    # Remove OAuth trigger tools + hide OAuth-based providers
# DATAPILOT_DISABLE_BROWSER=1  # Remove in-app browser tool
# DATAPILOT_DISABLE_VALIDATION=1 # Remove mermaid_validate/skill_validate tools
# DATAPILOT_DISABLE_TEMPLATES=1  # Remove render_template/script_sandbox tools
# DATAPILOT_LITE_UI=1           # Hide What's New, Help menu, extra statuses

# Batch processing tuning
# DATAPILOT_BATCH_GLOBAL_MAX_CONCURRENT_SESSIONS=10  # Global ceiling on concurrent sessions across all batches (per-batch maxConcurrency still applies; effective = min of the two)

# Sentry Error Tracking (captures crashes and chat/SDK errors)
# Get the ingest URL from Sentry > Project Settings > Client Keys (DSN)
SENTRY_ELECTRON_INGEST_URL=https://your-public-key@o0.ingest.sentry.io/0

# Web Search / Fetch Providers (OPTIONAL — fork-only)
# One key per vendor covers both web_search and web_fetch.
# Cascade order: TinyFish → Firecrawl → Tavily → Exa → DuckDuckGo (search: always-on
# universal fallback; fetch: empty cascade falls through to the local fetch+Turndown
# path automatically). A provider is included in the cascade only when its key is set.
#
# Multiple keys per vendor: set a comma-separated list to spread load across two or
# more accounts and raise the effective per-key rate limit. One key is chosen at
# random per request; a failed request still falls through to the next vendor (no
# in-vendor retry). Example: TINYFISH_API_KEY=key_a,key_b
# TINYFISH_API_KEY=
# FIRECRAWL_API_KEY=
# TAVILY_API_KEY=
# EXA_API_KEY=
